# ============================================================================
# Koncave Cinema Web: environment template
# Copy to .env.local and fill in. Validated at startup by src/env.ts.
# Never put secrets in NEXT_PUBLIC_* variables: they are shipped to the browser.
# ============================================================================

# Public origin of this app (the dev server runs on port 8000; the API on 3000, with CORS_ORIGIN=http://localhost:8000)
NEXT_PUBLIC_APP_URL=http://localhost:8000

# koncavecinema-api base URL including its /api prefix.
# Add NEXT_PUBLIC_APP_URL to the API's CORS_ORIGIN so cookies and credentials are accepted.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Optional: URL the Next.js server uses to reach the API (private network); defaults to the above
# API_INTERNAL_URL=

# Local development against staging: the refresh cookie is SameSite=Strict, so the browser won't
# send it from localhost to the staging API. Forward /api through this app instead:
# NEXT_PUBLIC_API_URL=http://localhost:8000/api
# API_INTERNAL_URL=https://staging-api.koncavecinema.com/api
# API_DEV_PROXY_URL=https://staging-api.koncavecinema.com/api

# Print every server-side API call (films, showtimes) in the terminal, with the full error body
# when one fails. Browser calls are in the Network tab as usual. Ignored in production
# API_DEBUG=true

# Where every page gets its data: "api" (default) or "fixtures" (sample films and a demo booking
# flow that never charges; for local development and design review)
NEXT_PUBLIC_DATA_SOURCE=api

# Staging only (Vercel: Preview, branch dev): every page asks for this password, any username,
# 12 characters or more. Never set it on production. Leave it unset locally.
# STAGING_PASSWORD=

# VERCEL_ENV is set by Vercel itself; anything but production is kept out of search engines.
