# ============================================================================
# Koncave Cinema Web: environment template
# Copy to .env.local and fill in. Validated at startup by src/env.ts.
# Never put secrets in NEXT_PUBLIC_* variables: they are shipped to the browser.
# ============================================================================

# Public origin of this app (dev server runs on port 3001; the API uses 3000)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# koncavecinema-api base URL including its /api prefix.
# Add NEXT_PUBLIC_APP_URL to the API's CORS_ORIGIN so cookies and credentials are accepted.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Optional: URL the Next.js server uses to reach the API (private network); defaults to the above
# API_INTERNAL_URL=

# ----------------------------------------------------------------------------
# Developer-only: used by `npm run api:types`, never read by the app (never NEXT_PUBLIC_).
# The API docs are open on a local API and behind Basic Auth on staging and production.
# ----------------------------------------------------------------------------
# API_OPENAPI_URL=http://localhost:3000/api/docs-json
# API_DOCS_USER=        # that environment's SWAGGER_USER (protected environments only)
# API_DOCS_PASSWORD=    # that environment's SWAGGER_PASSWORD (protected environments only)
